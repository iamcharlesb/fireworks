# Copy to .env and load it in your host application. IDs below preserve previous defaults; verify availability with your provider.
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-2.0-flash
PERPLEXITY_MODEL=llama-3.1-sonar-large-128k-online
OLLAMA_MODEL=llama3.2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MODEL_PRICING_JSON={}

# Secrets belong only in the ignored .env or your deployment secret manager.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
