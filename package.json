{
  "name": "fireworks-plus-plus",
  "version": "0.1.0",
  "description": "Fireworks++ \u2014 A TypeScript-first agentic AI framework for building LLM-powered applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fireworks-plus-plus": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-APACHE-2.0"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "test": "npm run check:secrets && npm run build && node --test test/**/*.test.cjs",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "desktop": "cd node/browser_agent && node scripts/desktop.js",
    "desktop:built": "cd node/browser_agent && node scripts/desktop.js",
    "desktop:attach": "cd node/browser_agent && node scripts/desktop.js --attach",
    "desktop:dev": "cd node/browser_agent && node scripts/desktopDev.js",
    "bots:build": "cd node/browser_agent && node node_modules/typescript/bin/tsc -p tsconfig.json",
    "bots:build:production": "cd node/browser_agent && node node_modules/typescript/bin/tsc -p tsconfig.json --outDir build",
    "bots:built": "cd node/browser_agent && node scripts/built.js",
    "bots:test": "cd node/browser_agent && npm test",
    "prepublishOnly": "npm run check:secrets && npm run build",
    "check:secrets": "node scripts/check-secrets.cjs"
  },
  "keywords": [
    "langchain",
    "llm",
    "agents",
    "ai",
    "anthropic",
    "openai",
    "gemini",
    "ollama",
    "perplexity",
    "rag",
    "embeddings",
    "vector-store",
    "chains",
    "prompts",
    "memory",
    "governance",
    "monitoring",
    "plugins",
    "workflows"
  ],
  "author": "Fireworks++ Contributors",
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "docx": "^9.6.1",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fireworks-plus-plus/fireworks-plus-plus"
  }
}
